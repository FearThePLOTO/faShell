{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "auto",               /* kitty/iterm/sixel autodetect; RGB in kitty, ghostty, wezterm */
    "source": "assets/fashell-face.jpg",
    "width": 24,                  /* small, leaves room for the text block */
    "padding": { "top": 1, "left": 2, "right": 4 }
  },
  "modules": [
    { "type": "custom", "format": "\u001b[38;2;120;130;75m  (╥﹏╥)\u001b[0m  \u001b[38;2;194;194;176mfaShell\u001b[0m" },
    { "type": "custom", "format": "" },
    { "type": "os",        "key": "  \u001b[38;2;120;130;75m✦\u001b[0m OS       " },
    { "type": "kernel",    "key": "  \u001b[38;2;120;130;75m✦\u001b[0m Kernel   " },
    { "type": "uptime",    "key": "  \u001b[38;2;120;130;75m✦\u001b[0m Uptime   " },
    { "type": "packages",  "key": "  \u001b[38;2;120;130;75m✦\u001b[0m Packages " },
    { "type": "shell",     "key": "  \u001b[38;2;120;130;75m✦\u001b[0m faShell  " },
    { "type": "terminal",  "key": "  \u001b[38;2;120;130;75m✦\u001b[0m Terminal " },
    "break",
    { "type": "custom", "format": "  \u001b[38;2;102;102;102m~ Unix shell in C — fails in style ~\u001b[0m" }
  ]
}
